NODE_ENV=production
PORT=5000
CLIENT_URL=https://votre-domaine.tn
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/ftjj
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=15m

# Stockage: local | cloudinary | s3 | ovh
STORAGE_PROVIDER=local
UPLOAD_MAX_MB=10
UPLOAD_ALLOWED_MIMES=image/jpeg,image/png,image/webp,application/pdf
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
S3_REGION=gra
S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=ftjj-documents
S3_PUBLIC_URL=

# Emails SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FTJJ <no-reply@votre-domaine.tn>"

# SMS placeholder
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=FTJJ

# Backups automatiques MongoDB
BACKUP_ENABLED=false
BACKUP_CRON=0 2 * * *
BACKUP_DIR=/var/backups/ftjj
